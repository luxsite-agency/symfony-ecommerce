# Приклад параметрів для `docker compose -f docker-compose.store.yml config` (CI, tests/store/run.sh). Не секрети.
# STORE_ROOT для config перекриває tests/store/run.sh (тимчасова тека з порожніми файлами секретів).
STORE_KEY=demo
STORE_ROOT=/work/stores/demo
STORE_TAG=0123456789ab-cafe0123
STORE_SITE_HOST=store-demo.localhost
STORE_ADMIN_HOST=store-demo-admin.localhost
STORE_X_ROBOTS_TAG=noindex, nofollow
COMPOSE_PROFILES=traefik
STORE_EDGE_NETWORK=edge
STORE_TRAEFIK_ENABLE=true
STORE_TRAEFIK_ENTRYPOINT=websecure
STORE_TRAEFIK_CERTRESOLVER=
STORE_MYSQL_BUFFER_POOL=192M
STORE_REAL_IP_HEADER=CF-Connecting-IP
