{% extends '@EasyAdmin/crud/detail.html.twig' %}
{% trans_default_domain 'admin' %}
{# Перегляд відгуку: стандартні поля + схвалити/відхилити (для не схваленого / не відхиленого) і відповідь магазину (POST з CSRF review-<id>). #}
{% set review = entity.instance %}
{% block main %}
    {{ parent() }}
    {% set token = csrf_token('review-' ~ review.id) %}
    {% set moderateUrl = path('admin_product_review_moderate', {entityId: review.id}) %}
    <div class="row mt-4" id="review-moderation">
        <div class="col-lg-5">
            <h3 class="h5">{{ 'review.detail.moderation'|trans }}</h3>
            <p class="text-muted">{{ 'review.detail.moderation_help'|trans }}</p>
            <div class="d-flex gap-2">
                {% if review.status.value != 'approved' %}
                    <form method="post" action="{{ moderateUrl }}" class="review-approve">
                        <input type="hidden" name="decision" value="approve">
                        <input type="hidden" name="token" value="{{ token }}">
                        <button type="submit" class="btn btn-success"><i class="fa fa-check"></i> {{ 'review.action.approve'|trans }}</button>
                    </form>
                {% endif %}
                {% if review.status.value != 'rejected' %}
                    <form method="post" action="{{ moderateUrl }}" class="review-reject">
                        <input type="hidden" name="decision" value="reject">
                        <input type="hidden" name="token" value="{{ token }}">
                        <button type="submit" class="btn btn-danger"><i class="fa fa-ban"></i> {{ 'review.action.reject'|trans }}</button>
                    </form>
                {% endif %}
            </div>
        </div>
        <div class="col-lg-7">
            <h3 class="h5">{{ 'review.field.reply_text'|trans }}</h3>
            <form method="post" action="{{ moderateUrl }}" class="review-reply-form">
                <input type="hidden" name="decision" value="reply">
                <input type="hidden" name="token" value="{{ token }}">
                <div class="mb-2">
                    <label class="form-label" for="review-reply">{{ 'review.detail.reply_label'|trans }}</label>
                    <textarea class="form-control" name="reply" id="review-reply" rows="4" maxlength="2000">{{ review.replyText }}</textarea>
                </div>
                <button type="submit" class="btn btn-primary"><i class="fa fa-reply"></i> {{ 'review.detail.reply_save'|trans }}</button>
            </form>
        </div>
    </div>
{% endblock %}
