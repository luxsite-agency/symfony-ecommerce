{# Заголовки таблиці: типово — лист покупцю (домен messages, мова замовлення); лист магазину передає
   items_domain: 'admin', items_prefix: 'email_order.', items_locale: мова адмінки (AdminLocales::default()). #}
{% set il = items_locale|default(order.locale) %}{% set idom = items_domain|default('messages') %}{% set ip = items_prefix|default('email.order.') %}
<table style="border-collapse:collapse;width:100%;font-family:system-ui,sans-serif;font-size:14px">
    <thead><tr>
        <th style="text-align:left;padding:6px;border-bottom:1px solid #ddd">{{ (ip ~ 'item')|trans({}, idom, il) }}</th>
        <th style="text-align:right;padding:6px;border-bottom:1px solid #ddd">{{ (ip ~ 'quantity')|trans({}, idom, il) }}</th>
        <th style="text-align:right;padding:6px;border-bottom:1px solid #ddd">{{ (ip ~ 'price')|trans({}, idom, il) }}</th>
        <th style="text-align:right;padding:6px;border-bottom:1px solid #ddd">{{ (ip ~ 'total')|trans({}, idom, il) }}</th>
    </tr></thead>
    <tbody>
    {# дочірні рядки — компоненти опцій: «у складі» без ціни, вона вже в батьківському рядку #}
    {% for item in order.items %}
        {% if item.parent is null %}
        <tr>
            <td style="padding:6px;border-bottom:1px solid #eee">{{ item.name }}<br><small style="color:#666">{{ item.sku }}</small></td>
            <td style="padding:6px;border-bottom:1px solid #eee;text-align:right">{{ item.quantity|qty(item.variant ? item.variant.unit, il) }}</td>
            <td style="padding:6px;border-bottom:1px solid #eee;text-align:right">{{ item.unitPrice|money(il) }}</td>
            <td style="padding:6px;border-bottom:1px solid #eee;text-align:right">{{ item.lineTotal|money(il) }}</td>
        </tr>
        {% else %}
        <tr>
            <td style="padding:2px 6px 6px 18px;border-bottom:1px solid #eee;color:#666" colspan="2"><small>{{ (ip ~ 'included')|trans({}, idom, il) }}: {{ item.name }} ({{ item.sku }}) × {{ item.quantity|qty(item.variant ? item.variant.unit, il) }}</small></td>
            <td style="border-bottom:1px solid #eee"></td><td style="border-bottom:1px solid #eee"></td>
        </tr>
        {% endif %}
    {% endfor %}
    </tbody>
    <tfoot><tr><th colspan="3" style="text-align:right;padding:6px">{{ (ip ~ 'grand_total')|trans({}, idom, il) }}</th><th style="text-align:right;padding:6px">{{ order.total|money(il) }}</th></tr></tfoot>
</table>
