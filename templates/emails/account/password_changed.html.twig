<p>{{ 'email.account.hello'|trans({name: name}, null, l) }}</p>
<p>{{ 'email.account.password_changed.text'|trans({site: siteName, minutes: ttl}, null, l) }}</p>
<p><a href="{{ url }}">{{ 'email.account.password_changed.button'|trans({}, null, l) }}</a></p>
<p style="color:#666">{{ 'email.account.password_changed.outro'|trans({minutes: ttl, hours: ttl // 60}, null, l) }}</p>
{% if detail %}<p style="color:#666">{{ 'email.account.password_changed.google'|trans({email: detail}, null, l) }}</p>{% endif %}
<p>{{ siteName }}</p>
