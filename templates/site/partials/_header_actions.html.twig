{# Дії в шапці: телефон, кабінет, кошик з лічильником, кнопка меню. Виводиться блоком header_actions базового шаблону —
   тема паку додає своє посилання так: {% block header_actions %}{{ parent() }}…{% endblock %} або перекриває цей файл.
   Змінні з контексту base.html.twig: phone (рядок|null, footer.phone теми), cart_count (int, рядків у кошику).
   Функції: path(), trans. Стабільні класи: header-actions, header-link, header-phone, account-link, cart-link, cart-label,
   cart-count, nav-toggle-btn, icon-burger, nav-toggle-label. #}
<div class="header-actions">
    {% if phone %}<a class="header-link header-phone" href="tel:{{ phone|replace({' ': '', '(': '', ')': '', '-': ''}) }}">{{ phone }}</a>{% endif %}
    {# без app.user: перевірка входу стартувала б сесію на кожній сторінці; /account/ сам веде на вхід #}
    <a class="header-link account-link" href="{{ path('site_account') }}" rel="nofollow">{{ 'site.nav.account'|trans }}</a>
    <a class="header-link cart-link" href="{{ path('site_cart') }}" rel="nofollow" aria-label="{{ 'site.nav.cart_count'|trans({count: cart_count}) }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.4 11.2a1 1 0 0 0 1 .8h9.2a1 1 0 0 0 1-.8L20.5 8H6.2"/><circle cx="9.5" cy="19.5" r="1.3"/><circle cx="17" cy="19.5" r="1.3"/></svg>
        <span class="cart-label">{{ 'site.nav.cart'|trans }}</span>
        {% if cart_count > 0 %}<span class="cart-count" aria-hidden="true">{{ cart_count }}</span>{% endif %}
    </a>
    <label class="header-link nav-toggle-btn" for="nav-toggle"><span class="icon-burger" aria-hidden="true"></span><span class="nav-toggle-label">{{ 'site.nav.menu'|trans }}</span></label>
</div>
