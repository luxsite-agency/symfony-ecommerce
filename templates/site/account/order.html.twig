{% extends 'site/base.html.twig' %}
{% set noindex = true %}
{% block title %}{{ 'site.account.orders.one_title'|trans({number: order.number}) }} | {{ site_name }}{% endblock %}
{% block body %}
    <h1>{{ 'site.account.orders.one_title'|trans({number: order.number}) }}</h1>
    {% include 'site/account/_flashes.html.twig' %}
    <p class="order-meta">
        {{ 'site.account.orders.date'|trans }}: {{ order.placedAt|date_short(true) }}<br>
        {{ 'site.account.orders.status'|trans }}: <span class="order-status order-status-{{ order.status }}">{{ ('site.account.orders.status_name.' ~ order.status)|trans }}</span><br>
        {{ 'site.account.orders.payment_status'|trans }}: {{ ('site.account.orders.payment_status_name.' ~ order.paymentStatus.value)|trans }}
    </p>
    <div class="order-box">
        <table class="cart order-summary order-items">
            <thead><tr><th>{{ 'site.cart.product'|trans }}</th><th>{{ 'site.cart.quantity'|trans }}</th><th>{{ 'site.cart.price'|trans }}</th><th>{{ 'site.cart.total'|trans }}</th></tr></thead>
            <tbody>
            {% for item in order.items %}{% if item.parent is null %}
                <tr>
                    <td data-label="{{ 'site.cart.product'|trans }}">{{ item.name }} <span class="meta">{{ item.sku }}</span></td>
                    <td data-label="{{ 'site.cart.quantity'|trans }}">{{ item.quantity|qty(item.variant ? item.variant.unit) }}</td>
                    <td class="price" data-label="{{ 'site.cart.price'|trans }}">{{ item.unitPrice|money }}</td>
                    <td class="price" data-label="{{ 'site.cart.total'|trans }}">{{ item.lineTotal|money }}</td>
                </tr>
            {% endif %}{% endfor %}
            </tbody>
            <tfoot><tr><th colspan="3">{{ 'email.order.grand_total'|trans }}</th><th class="price order-total">{{ order.total|money }}</th></tr></tfoot>
        </table>
        {% if order.source.value != 'quick' %}
            <p>{{ 'site.checkout.shipping_title'|trans }}: {{ ('site.checkout.shipping.' ~ order.shippingMethod.value)|trans }}{% if order.shippingCity %}, {{ order.shippingCity }}{% endif %}{% if order.shippingAddress %}, {{ order.shippingAddress }}{% endif %}<br>
            {{ 'site.checkout.payment_title'|trans }}: {{ ('site.checkout.payment.' ~ order.paymentMethod.value)|trans }}</p>
        {% endif %}
        {% if order.comment %}<p class="order-comment">{{ 'site.account.orders.comment'|trans }}: {{ order.comment }}</p>{% endif %}
    </div>
    <form method="post" action="{{ path('site_account_order_reorder', {id: order.id}) }}" class="order-reorder">
        <input type="hidden" name="_token" value="{{ csrf_token('account') }}">
        <button type="submit" class="btn btn-primary">{{ 'site.account.orders.reorder'|trans }}</button>
    </form>
    <ul class="account-links">
        <li><a href="{{ path('site_account_orders') }}">{{ 'site.account.orders.back'|trans }}</a></li>
    </ul>
{% endblock %}
