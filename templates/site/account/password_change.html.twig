{% extends 'site/base.html.twig' %}
{% set noindex = true %}
{% block title %}{{ 'site.account.profile.change_password'|trans }} | {{ site_name }}{% endblock %}
{% block body %}
    <h1>{{ 'site.account.profile.change_password'|trans }}</h1>
    {% if app.user.password is null %}
        {% include 'site/account/_no_password.html.twig' %}
    {% else %}
        <form method="post" action="{{ path('site_account_profile_password') }}" class="account-form password-form" novalidate>
            <input type="hidden" name="{{ field_name(form._token) }}" value="{{ field_value(form._token) }}">
            {% include 'site/account/_field.html.twig' with {field: form.current, label: 'site.account.profile.current_password'|trans, type: 'password', autocomplete: 'current-password'} only %}
            {% include 'site/account/_field.html.twig' with {field: form.password, label: 'site.account.password_new'|trans, type: 'password', autocomplete: 'new-password'} only %}
            <p class="meta">{{ 'site.account.profile.password_note'|trans }}</p>
            <button type="submit" class="btn btn-primary">{{ 'site.account.reset.save'|trans }}</button>
        </form>
    {% endif %}
    <ul class="account-links"><li><a href="{{ path('site_account_profile') }}">{{ 'site.account.profile.back'|trans }}</a></li></ul>
{% endblock %}
