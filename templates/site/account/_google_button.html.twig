{# Кнопка «Продовжити з Google» (вхід і реєстрація — одна дія). Показується лише з ключами (google_sign_in_enabled()).
   Параметр next — відносний шлях повернення (лише /…, інакше кабінет; ReturnPath). Під кнопкою — текст згоди на обробку ПД:
   для нового покупця це замінює чекбокс реєстрації (журнал згод, джерело google). Використовує і модальне «увійдіть,
   щоб залишити відгук» (reviews-feature.md): include 'site/account/_google_button.html.twig' with {next: app.request.pathInfo} #}
{% if google_sign_in_enabled() %}
    <div class="google-sign-in">
        <a class="btn btn-outline btn-google" rel="nofollow" href="{{ path('site_account_google_start', next ?? null ? {next: next} : {}) }}">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.3l7.9 6.1C12.4 13.6 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.3 5.5-4.8 7.2l7.5 5.8c4.4-4.1 7.1-10.1 7.1-17.5z"/><path fill="#FBBC05" d="M10.5 28.6A14.5 14.5 0 0 1 9.7 24c0-1.6.3-3.1.8-4.6l-7.9-6.1A24 24 0 0 0 0 24c0 3.9.9 7.5 2.6 10.7l7.9-6.1z"/><path fill="#34A853" d="M24 48c6.3 0 11.7-2.1 15.6-5.7l-7.5-5.8c-2.1 1.4-4.8 2.3-8.1 2.3-6.3 0-11.6-4.1-13.5-9.9l-7.9 6.1C6.5 42.6 14.6 48 24 48z"/></svg>
            {{ 'site.account.google.button'|trans }}
        </a>
        <p class="meta google-consent">{{ 'site.account.google.consent'|trans }}</p>
    </div>
{% endif %}
