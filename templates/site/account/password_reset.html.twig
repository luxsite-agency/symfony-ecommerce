{% extends 'site/base.html.twig' %}
{% set noindex = true %}
{% block title %}{{ 'site.account.reset.new_title'|trans }} | {{ site_name }}{% endblock %}
{% block body %}
    <h1>{{ 'site.account.reset.new_title'|trans }}</h1>
    {% if form %}
        <form method="post" class="account-form" novalidate>
            <input type="hidden" name="{{ field_name(form._token) }}" value="{{ field_value(form._token) }}">
            {% include 'site/account/_field.html.twig' with {field: form.password, label: 'site.account.password_new'|trans, type: 'password', autocomplete: 'new-password'} only %}
            <button type="submit" class="btn btn-primary">{{ 'site.account.reset.save'|trans }}</button>
        </form>
    {% else %}
        <p class="flash flash-error" role="alert">{{ 'site.account.error.link_invalid'|trans }}</p>
        <p><a href="{{ path('site_account_password') }}">{{ 'site.account.reset.again'|trans }}</a></p>
    {% endif %}
{% endblock %}
